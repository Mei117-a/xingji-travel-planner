.sum-row { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 12rpx; }
.sum-label { font-size: 22rpx; color: #9c9287; display: block; }
.sum-total { font-size: 48rpx; font-weight: 600; color: #12584a; }
.sum-total.bad { color: #c0392b; }
.sum-side { text-align: right; }
.sum-remain { font-size: 26rpx; color: #12795f; display: block; }
.sum-remain.bad { color: #c0392b; }
.sum-src { font-size: 20rpx; color: #9c9287; }

.map { width: 100%; height: 420rpx; border-radius: 16rpx; }

.tip { display: flex; margin-bottom: 8rpx; }
.tip-dot { color: #12584a; margin-right: 10rpx; font-weight: 600; }
.tip-text { flex: 1; font-size: 24rpx; color: #5f574d; }

.day-head {
  display: flex; align-items: center; gap: 12rpx;
  padding-bottom: 14rpx; margin-bottom: 8rpx;
  border-bottom: 1rpx solid #f2ece3;
}
.day-badge {
  font-size: 20rpx; font-weight: 700; color: #fff;
  background: #12584a; padding: 4rpx 12rpx; border-radius: 8rpx;
}
.day-title { flex: 1; font-size: 28rpx; font-weight: 600; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.day-sub { font-size: 20rpx; color: #9c9287; }

.item {
  display: flex; align-items: center; gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #f2ece3;
}
.item:last-of-type { border-bottom: 0; }
.icon {
  flex: 0 0 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  background: #f4efe7; color: #5f574d; font-size: 20rpx; border-radius: 8rpx;
}
.syslabel { flex: 0 0 88rpx; font-size: 22rpx; color: #9c9287; }
.time {
  flex: 0 0 108rpx;
  background: transparent; font-size: 24rpx; color: #5f574d; text-align: center;
}
.mid { flex: 1; min-width: 0; }
.txt { font-size: 26rpx; width: 100%; }
.sys-txt { font-size: 24rpx; color: #5f574d; }
.meta { margin-top: 2rpx; }
.meta-text { font-size: 20rpx; color: #1c7a67; }

.right { display: flex; align-items: center; gap: 10rpx; flex: 0 0 auto; }
.cost { position: relative; }
.yen { position: absolute; left: 10rpx; top: 50%; transform: translateY(-50%); font-size: 20rpx; color: #9c9287; }
.cost-input {
  width: 96rpx; background: #fbf9f5; border-radius: 8rpx;
  font-size: 24rpx; padding: 8rpx 8rpx 8rpx 28rpx; box-sizing: border-box; text-align: right;
}
.amount { font-size: 22rpx; color: #5f574d; font-weight: 500; min-width: 70rpx; text-align: right; }
.ops { display: flex; gap: 6rpx; }
.op {
  width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center;
  color: #9c9287; background: #f7f3ec; border-radius: 8rpx; font-size: 26rpx;
}
.op.del { color: #c0392b; background: #fcecea; }
.add-btn {
  margin-top: 12rpx;
  background: #fdfbf7; color: #1c7a67;
  border: 1rpx dashed #ded5c7; font-size: 24rpx;
}

.empty-btn { margin-top: 30rpx; width: 60%; }
.empty-sub { display: block; margin-top: 12rpx; font-size: 22rpx; }

/* 旅游搭子协作 */
.buddy-row { display: flex; align-items: center; gap: 14rpx; margin-top: 16rpx; }
.buddy-btn { flex: 0 0 auto; }
.join-input {
  flex: 1; min-width: 0;
  background: #fbf9f5; border: 1rpx solid #eae3d8; border-radius: 12rpx;
  padding: 10rpx 20rpx; font-size: 26rpx;
  text-align: center; letter-spacing: 6rpx; font-weight: 600;
}
.buddy-code-row { display: flex; align-items: center; gap: 16rpx; }
.buddy-code-label { font-size: 24rpx; color: #9c9287; }
.buddy-code {
  font-size: 40rpx; font-weight: 700; color: #12584a; letter-spacing: 10rpx;
}
.buddy-hint { margin-top: 10rpx; }

/* 行程规划图 */
.poster-btn { width: 60%; }
.poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 375px;
  height: 700px;
}
