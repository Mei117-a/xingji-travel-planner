.page { padding-bottom: 60rpx; }

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 36rpx;
}
.logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  background: #12584a;
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx -18rpx rgba(18, 88, 74, 0.6);
}
.app-name {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #211d19;
}
.app-sub { margin-top: 6rpx; font-size: 24rpx; color: #9c9287; }

.team-card { padding: 32rpx; }
.team-label {
  font-size: 22rpx;
  color: #9c9287;
  letter-spacing: 2rpx;
}
.team-name-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 8rpx;
}
.team-name { font-size: 44rpx; font-weight: 700; color: #12584a; }
.team-count { font-size: 24rpx; color: #9c9287; }

.member-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}
.member {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f7f4ef;
  border: 1rpx solid #eae3d8;
}
.member.leader { background: #eaf4f0; border-color: #b7d8ce; }
.m-name { font-size: 26rpx; color: #211d19; }
.member.leader .m-name { color: #12584a; font-weight: 600; }
.m-badge {
  font-size: 20rpx;
  color: #ffffff;
  background: #12584a;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}

.advisor {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed #eae3d8;
}
.info-k { font-size: 24rpx; color: #9c9287; }
.info-v { font-size: 28rpx; color: #211d19; font-weight: 500; }

.desc { font-size: 26rpx; color: #5f574d; line-height: 1.7; display: block; }
.feat-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.feat {
  font-size: 22rpx;
  color: #12584a;
  background: #eaf4f0;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.foot { display: flex; flex-direction: column; align-items: center; gap: 6rpx; margin-top: 26rpx; }
.share-btn { margin: 30rpx 40rpx 0; }
.slogan {
  margin-top: 14rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #c9762b;
  letter-spacing: 4rpx;
}
