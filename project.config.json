{
  "description": "行迹 · 旅行规划微信小程序",
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": ".workbuddy" },
      { "type": "folder", "value": "node_modules" },
      { "type": "folder", "value": "_rawimg" }
    ],
    "include": []
  },
  "setting": {
    "bundle": false,
    "es6": true,
    "minified": true,
    "postcss": true,
    "urlCheck": true,
    "packNpmManually": true,
    "packNpmRelationList": [
      {
        "packageJsonPath": "./package.json",
        "miniprogramNpmDistDir": "./miniprogram/"
      }
    ]
  },
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "xingji-miniprogram",
  "miniprogramRoot": "miniprogram/"
}
